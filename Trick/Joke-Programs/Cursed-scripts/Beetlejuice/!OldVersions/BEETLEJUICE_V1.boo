# Start of script
# Halloween Assistant joke programs
# Program to summon beetlejuice
# To avoid summoning while I write this program, the name has only been
# invoked twice throughout this file
# Just a fun little program for Halloween
x = 3
while (x != 0):
    print("Beetlejuice") # Say his name 3 times
    x == x - 1 # May need to be revised
print("He has been summoned")
noMore = input("Press [ENTER] to quit") # Just so it doesn't auto-close
break
